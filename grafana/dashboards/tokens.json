    {
      "type": "stat",
      "title": "Total tokens (in time range)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue" }] } }
      },
      "targets": [
        {
          "expr": "sum(increase({__name__=~\"gen_ai_client_token_usage(_tokens)?(_sum|_total)\", gen_ai_token_type!=\"total\"}[$__range]))",
          "legendFormat": "tokens",
          "refId": "A"
        }
